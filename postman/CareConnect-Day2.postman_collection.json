      "name": "00 Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"db UP\",()=>pm.expect(pm.response.json().database).to.eql(\"UP\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "01 Register PARENT",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const s = Date.now();",
              "pm.collectionVariables.set('parentEmail', `parent_${s}@test.com`);",
              "pm.collectionVariables.set('childEmail', `child_${s}@test.com`);",
              "pm.collectionVariables.set('parent2Email', `parent2_${s}@test.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
              "const j = pm.response.json();",
              "pm.test('token + no password hash', () => { pm.expect(j.token).to.be.a('string'); pm.expect(JSON.stringify(j)).to.not.include('password'); });",
              "pm.collectionVariables.set('parentToken', j.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
